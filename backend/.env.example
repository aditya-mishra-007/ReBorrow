# ==============================================================================
# ReBorrow Backend - Environment Variables
# ==============================================================================
# Copy this file to `.env` and replace the placeholder values with your own.
# Never commit your actual `.env` file to version control.

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Environment mode: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------

# MongoDB connection string
#
# Example (MongoDB Atlas):
# mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxx.mongodb.net/ReBorrow
#
# Example (Local Replica Set):
# mongodb://localhost:27017/ReBorrow?replicaSet=rs0
#
# Note:
# This project uses MongoDB transactions, so your MongoDB instance must
# be running as a replica set.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/ReBorrow

# ------------------------------------------------------------------------------
# Authentication / JWT Configuration
# ------------------------------------------------------------------------------

# Generate a secure secret:
# openssl rand -base64 48
JWT_SECRET=your_super_secure_jwt_secret

# Examples: 1h, 7d, 30d
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------------------------

# Frontend URL (no trailing slash)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Cloudinary Configuration
# ------------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev